---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body
    class="min-h-screen bg-hueso font-body text-tinta antialiased selection:bg-vino selection:text-hueso"
  >
    <slot />

    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (!reduce) {
        gsap.registerPlugin(ScrollTrigger);

        // Smooth scroll (Lenis) sincronizado con ScrollTrigger.
        const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));

        // Lenis desplaza la página por JS, no con el scroll nativo: por eso
        // `body { overflow: hidden }` no lo detiene. Cualquier capa que se abra
        // encima avisa por evento para que suelte la rueda.
        document.addEventListener("capa:abrir", () => lenis.stop());
        document.addEventListener("capa:cerrar", () => lenis.start());

        // Los enlaces de ancla los resolvía el navegador de un salto: Lenis no
        // los intercepta solo. Se delega el clic para que también funcione con
        // los del menú de celular, que se pintan aparte.
        // El aire bajo la barra fija NO se calcula aquí: lo pone el
        // `scroll-margin-top` de global.css, que Lenis ya respeta. Sumarlo
        // también en JS lo contaba dos veces y la sección caía muy abajo.
        document.addEventListener("click", (e) => {
          const enlace = (e.target as HTMLElement)?.closest?.<HTMLAnchorElement>(
            'a[href^="#"]'
          );
          if (!enlace) return;

          const destino = enlace.getAttribute("href");
          if (!destino) return;

          // "#" a secas es el nombre de la barra: vuelve arriba del todo.
          if (destino === "#") {
            e.preventDefault();
            lenis.scrollTo(0, { duration: 1.1 });
            return;
          }

          const seccion = document.querySelector(destino);
          if (!seccion) return;

          e.preventDefault();
          lenis.scrollTo(seccion as HTMLElement, {
            duration: 1.1,
            easing: (t: number) => 1 - Math.pow(1 - t, 3),
          });
          history.pushState(null, "", destino);
        });
        gsap.ticker.lagSmoothing(0);

        // Reveal genérico: cualquier elemento con [data-reveal] entra al hacer scroll.
        gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
          gsap.from(el, {
            y: 40,
            opacity: 0,
            duration: 0.9,
            ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 85%" },
          });
        });
      }
    </script>
  </body>
</html>
