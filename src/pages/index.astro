---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Banner from "../components/Banner.astro";
import Work from "../components/Work.astro";
import Filosofia from "../components/Filosofia.astro";
import Capacidades from "../components/Capacidades.astro";
import BannerHerramientas from "../components/BannerHerramientas.astro";
import SobreMi from "../components/SobreMi.astro";
import Trayectoria from "../components/Trayectoria.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<Layout
  title={`${site.name} — ${site.role}`}
  description={`${site.name}. ${site.role}, ${site.location}. Estrategia, marca, contenido y resultados.`}
>
  <Nav />
  <Hero />
  <Banner />
  <Work />
  <Capacidades />
  <BannerHerramientas />
  <Filosofia />
  <SobreMi />
  <Trayectoria />
  <Contacto />
  <Footer />
</Layout>
