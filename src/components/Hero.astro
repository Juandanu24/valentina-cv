---
import { site, hero } from "../data/site";
---

<header class="mx-auto max-w-6xl px-5 pb-20 pt-32 sm:px-8 sm:pt-40">
  <h1
    class="hero-hook max-w-4xl font-display text-[clamp(2.2rem,6.5vw,4.8rem)] font-extrabold leading-[1.02] text-marino"
  >
    Las marcas no necesitan más contenido.
    <span class="text-vino">Necesitan mejores ideas.</span>
  </h1>

  <div class="mt-14 grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16">
    <div class="hero-el">
      <p class="font-display text-xl font-bold text-marino">{site.name}</p>
      <p class="mt-2 font-mono text-xs uppercase tracking-widest text-marino/60">
        {site.role} · {site.location}
      </p>
    </div>

    <div class="hero-el space-y-4 text-lg leading-relaxed text-tinta/85">
      {hero.intro.map((p) => <p>{p}</p>)}
      <a
        href="#trabajo"
        class="mt-4 inline-block bg-vino px-6 py-3.5 font-mono text-xs uppercase tracking-widest text-hueso transition-colors hover:bg-quemado"
      >
        {hero.cta} ↓
      </a>
    </div>
  </div>
</header>

<script>
  import { gsap } from "gsap";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce) {
    gsap
      .timeline({ defaults: { ease: "power3.out" } })
      .from(".hero-hook", { y: 30, opacity: 0, duration: 0.9 })
      .from(".hero-el", { y: 20, opacity: 0, duration: 0.7, stagger: 0.15 }, "-=0.5");
  }
</script>
