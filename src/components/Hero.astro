---
import { site, hero } from "../data/site";

// Retrato SIN FONDO (png transparente). Guardar en public/valentina.png
const foto = "/valentina.png";
---

<header class="mx-auto max-w-6xl px-5 pb-16 pt-28 sm:px-8 sm:pt-32">
  <div class="grid items-end gap-8 md:grid-cols-[1.05fr_0.95fr] md:gap-14">
    <!-- Columna de texto -->
    <div class="pb-4">
      <p class="hero-el font-mono text-[11px] uppercase tracking-[0.2em] text-oliva">
        {site.role} · {site.location}
      </p>

      <h1
        class="hero-name mt-4 font-name text-[clamp(3rem,8.5vw,6rem)] leading-[0.95] tracking-tight text-marino"
      >
        Valentina<br /><span class="italic text-vino">García Flórez</span>
      </h1>

      <p
        class="hero-el mt-6 max-w-lg font-display text-[clamp(1.25rem,2.4vw,1.8rem)] leading-snug text-marino"
      >
        Las marcas no necesitan más contenido.
        <span class="italic text-vino">Necesitan mejores ideas.</span>
      </p>

      <div class="hero-el mt-5 max-w-lg space-y-3 leading-relaxed text-tinta/80">
        {hero.intro.map((p) => <p>{p}</p>)}
      </div>

      <a
        href="#trabajo"
        class="hero-el mt-7 inline-block rounded-pill bg-vino px-7 py-3.5 font-mono text-xs uppercase tracking-widest text-hueso transition-colors hover:bg-quemado"
      >
        {hero.cta} ↓
      </a>
    </div>

    <!-- Retrato recortado sobre forma de color -->
    <figure class="hero-foto relative mx-auto w-full max-w-sm md:max-w-none">
      <!-- Arco de fondo -->
      <div
        aria-hidden="true"
        class="absolute inset-x-4 bottom-0 top-8 rounded-t-full bg-oliva/20"
      >
      </div>
      <img
        src={foto}
        alt={`Retrato de ${site.name}`}
        width="900"
        height="1125"
        class="relative mx-auto block w-full max-w-[22rem] object-contain md:max-w-none"
        onerror="this.style.display='none'"
      />
    </figure>
  </div>
</header>

<script>
  import { gsap } from "gsap";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce) {
    gsap
      .timeline({ defaults: { ease: "power3.out" } })
      .from(".hero-name", { y: 24, opacity: 0, duration: 0.85 })
      .from(".hero-foto", { opacity: 0, y: 20, duration: 0.9 }, "-=0.6")
      .from(".hero-el", { y: 14, opacity: 0, duration: 0.6, stagger: 0.12 }, "-=0.7");
  }
</script>
