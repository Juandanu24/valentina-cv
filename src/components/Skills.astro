---
import { skills } from "../data/site";

// Colores vivos en ciclo para las skills expertas.
const chipColors = [
  "bg-magenta text-white",
  "bg-yellow text-ink",
  "bg-teal text-ink",
  "bg-violet text-white",
];
const rots = [-3, 2, -2, 3, -1, 2, -3, 1];
---

<section id="habilidades" class="bg-ink px-5 py-24 text-paper sm:px-8 sm:py-32 lg:px-12">
  <p
    data-reveal
    class="mb-12 font-mono text-xs uppercase tracking-[0.25em] text-paper/50"
  >
    04 — habilidades
  </p>

  <div class="space-y-12">
    <div data-reveal>
      <h3 class="mb-6 font-mono text-sm uppercase tracking-widest text-teal">
        ● Nivel experto
      </h3>
      <ul class="flex flex-wrap gap-3">
        {
          skills.expert.map((s, i) => (
            <li
              class:list={[
                "inline-block rounded-lg border-2 border-paper px-4 py-2 font-display text-base font-bold sm:text-lg",
                chipColors[i % chipColors.length],
              ]}
              style={`rotate: ${rots[i % rots.length]}deg`}
            >
              {s}
            </li>
          ))
        }
      </ul>
    </div>

    <div data-reveal>
      <h3 class="mb-6 font-mono text-sm uppercase tracking-widest text-paper/50">
        ○ Nivel intermedio
      </h3>
      <ul class="flex flex-wrap gap-3">
        {
          skills.intermediate.map((s) => (
            <li class="inline-block rounded-lg border-2 border-paper/40 px-4 py-2 font-display text-base font-bold text-paper/80">
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
