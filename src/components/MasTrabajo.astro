---
import { masTrabajo } from "../data/site";
---

<!--
  Remate de la sección de proyectos. El botón abre una ventana dentro de la misma
  página (<dialog> nativo: cierra con Esc, atrapa el foco y trae su propio fondo).
  Los videos no se descargan hasta que la ventana se abre.
-->
<button
  type="button"
  data-abrir-mas
  data-reveal
  class="group mt-16 flex w-full flex-col items-start gap-6 overflow-hidden rounded-suave bg-oliva px-7 py-9 text-left text-hueso shadow-[0_4px_18px_rgba(85,96,58,0.18)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(85,96,58,0.3)] sm:flex-row sm:items-center sm:justify-between sm:px-11 sm:py-12"
>
  <span>
    <span class="block font-display text-3xl leading-tight sm:text-4xl">
      {masTrabajo.title}
    </span>
    <span class="mt-3 block max-w-md leading-relaxed text-hueso/75">
      {masTrabajo.body}
    </span>
  </span>

  <span
    class="inline-flex shrink-0 items-center gap-3 rounded-pill bg-hueso px-7 py-4 font-mono text-xs uppercase tracking-widest text-oliva transition-colors duration-300 group-hover:bg-marino group-hover:text-hueso"
  >
    {masTrabajo.cta}
    <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
      →
    </span>
  </span>
</button>

<dialog
  id="mas-trabajo"
  aria-labelledby="mas-trabajo-titulo"
  class="m-auto max-h-[86vh] w-[min(72rem,92vw)] overflow-hidden rounded-suave bg-hueso p-0 text-tinta shadow-[0_24px_60px_rgba(30,42,56,0.3)] backdrop:bg-marino/70 backdrop:backdrop-blur-sm"
>
  <!-- La altura se controla en este envoltorio y no en el <dialog>: así el
       desplazamiento vive dentro de la ventana y no se va a la página de atrás. -->
  <div class="flex max-h-[86vh] flex-col">
  <div
    class="flex shrink-0 items-start justify-between gap-4 border-b border-marino/12 px-5 py-5 sm:px-8"
  >
    <div>
      <h2 id="mas-trabajo-titulo" class="font-display text-2xl text-marino sm:text-3xl">
        {masTrabajo.tituloVentana}
      </h2>
    </div>

    <button
      type="button"
      data-cerrar-mas
      aria-label="Cerrar"
      class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-marino/20 text-marino transition-colors hover:border-vino hover:bg-vino hover:text-hueso"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>
  </div>

  <!-- min-h-0 permite que este bloque se encoja y tenga su propio desplazamiento.
       data-lenis-prevent es imprescindible: Lenis intercepta la rueda y llama a
       preventDefault, así que sin este atributo el contenedor no se desplaza
       aunque tenga overflow-y:auto. Detener Lenis no basta; hay que decirle que
       ignore los gestos que ocurren aquí dentro. -->
  <div
    data-lenis-prevent
    class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 py-6 sm:px-8 sm:py-8"
  >
    <!-- Tres por fila. La pieza de formato distinto ocupa la fila entera al final. -->
    <ul class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3">
      {
        masTrabajo.piezas.map((pieza, i) => (
          <li
            class:list={[
              "relative rounded-suave border border-marino/15 bg-hueso shadow-[0_2px_10px_rgba(30,42,56,0.07)]",
              pieza.ancho && "col-span-full",
            ]}
            data-pieza
          >
            {/* Toda la ficha es el disparador del desplegable: el clic no navega. */}
            <button
              type="button"
              data-abrir-menu
              aria-expanded="false"
              aria-controls={`menu-pieza-${i}`}
              class="relative block h-full w-full cursor-pointer rounded-suave text-left"
            >
            <div
              class:list={[
                "overflow-hidden rounded-suave bg-marino",
                pieza.ancho ? "aspect-[64/15]" : "aspect-[9/16]",
              ]}
            >
              {pieza.type === "video" ? (
                <video
                  data-src={pieza.src}
                  data-poster={pieza.poster}
                  muted
                  loop
                  playsinline
                  preload="none"
                  class="h-full w-full object-cover"
                />
              ) : (
                // Sin `src` ni `loading="lazy"`: dentro de un <dialog> cerrado el
                // navegador puede igual descargarla. Queda en `data-src` y el
                // script la asigna solo cuando la pieza entra en vista.
                <img
                  data-src={pieza.src}
                  alt={pieza.label}
                  class="h-full w-full object-cover"
                />
              )}
            </div>
              {/* Sin rótulo ni flecha: la pieza habla sola. Se retiró la "⌄" de la
                  esquina porque se leía como un elemento vacío. */}
            </button>

            {/* Desplegable: aparece bajo la ficha, no navega de inmediato. */}
            <div
              id={`menu-pieza-${i}`}
              data-menu
              hidden
              class="absolute left-1/2 top-1/2 z-10 w-[min(88%,13rem)] -translate-x-1/2 -translate-y-1/2 rounded-suave border border-marino/15 bg-hueso p-1.5 shadow-[0_10px_28px_rgba(30,42,56,0.28)]"
            >
              {pieza.instagram && pieza.instagram !== "#" ? (
                <a
                  href={pieza.instagram}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center justify-between gap-2 rounded-[0.5rem] px-3 py-2.5 font-mono text-[10px] uppercase tracking-wide text-marino transition-colors hover:bg-vino hover:text-hueso"
                >
                  Ver en Instagram
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <p class="px-3 py-2.5 font-mono text-[10px] uppercase leading-tight tracking-wide text-marino/40">
                  Enlace pendiente
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  </div>
</dialog>

<script>
  const dialogo = document.getElementById("mas-trabajo") as HTMLDialogElement | null;
  const abrir = document.querySelector<HTMLButtonElement>("[data-abrir-mas]");
  const cerrar = document.querySelector<HTMLButtonElement>("[data-cerrar-mas]");
  const caja = dialogo?.querySelector<HTMLElement>("[data-lenis-prevent]") ?? null;

  if (dialogo && abrir && caja) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fichas = [...dialogo.querySelectorAll<HTMLElement>("[data-pieza]")];

    // --- Carga y reproducción por visibilidad dentro de la caja -----------
    // Solo las piezas visibles (o a punto de estarlo) dentro de la ventana
    // reciben `src`/`poster` y se reproducen. Al salir de vista se pausan,
    // pero conservan el `src`: no hace falta volver a descargarlas.
    const cargarPieza = (ficha: HTMLElement) => {
      const video = ficha.querySelector<HTMLVideoElement>("video[data-src]");
      if (video) {
        if (!video.poster && video.dataset.poster) video.poster = video.dataset.poster;
        if (!video.src && video.dataset.src) video.src = video.dataset.src;
        return;
      }
      const img = ficha.querySelector<HTMLImageElement>("img[data-src]");
      if (img && !img.src && img.dataset.src) img.src = img.dataset.src;
    };

    const observadorPiezas = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          const ficha = entrada.target as HTMLElement;
          const video = ficha.querySelector<HTMLVideoElement>("video");
          if (entrada.isIntersecting) {
            cargarPieza(ficha);
            if (video && !reduce) video.play().catch(() => {});
          } else {
            video?.pause();
          }
        });
      },
      { root: caja, rootMargin: "200px 0px" }
    );
    fichas.forEach((ficha) => observadorPiezas.observe(ficha));

    abrir.addEventListener("click", () => {
      dialogo.showModal();
      // Sin esto Lenis sigue moviendo la página de atrás: no usa scroll nativo,
      // así que `overflow: hidden` en el body no lo frena.
      document.dispatchEvent(new CustomEvent("capa:abrir"));
      document.body.style.overflow = "hidden";
    });

    const cerrarVentana = () => dialogo.close();
    cerrar?.addEventListener("click", cerrarVentana);

    // Clic en el fondo (fuera del contenido) también cierra.
    dialogo.addEventListener("click", (e) => {
      if (e.target === dialogo) cerrarVentana();
    });

    dialogo.addEventListener("close", () => {
      document.dispatchEvent(new CustomEvent("capa:cerrar"));
      document.body.style.overflow = "";
      dialogo.querySelectorAll<HTMLVideoElement>("video").forEach((v) => v.pause());
      cerrarMenus();
    });

    // --- Desplegable por pieza --------------------------------------------
    // El clic en una ficha no navega: abre un menú con el enlace al Instagram
    // del cliente. Solo uno abierto a la vez.

    function cerrarMenus(excepto?: HTMLElement) {
      fichas.forEach((ficha) => {
        if (ficha === excepto) return;
        const menu = ficha.querySelector<HTMLElement>("[data-menu]");
        const boton = ficha.querySelector<HTMLButtonElement>("[data-abrir-menu]");
        if (menu) menu.hidden = true;
        boton?.setAttribute("aria-expanded", "false");
      });
    }

    fichas.forEach((ficha) => {
      const boton = ficha.querySelector<HTMLButtonElement>("[data-abrir-menu]");
      const menu = ficha.querySelector<HTMLElement>("[data-menu]");
      if (!boton || !menu) return;

      boton.addEventListener("click", () => {
        const abierto = boton.getAttribute("aria-expanded") === "true";
        cerrarMenus(ficha);
        menu.hidden = abierto;
        boton.setAttribute("aria-expanded", String(!abierto));
      });
    });

    // Clic fuera de cualquier ficha: se recogen todos.
    dialogo.addEventListener("click", (e) => {
      if (!(e.target as HTMLElement).closest("[data-pieza]")) cerrarMenus();
    });

    // Esc recoge el menú antes de cerrar la ventana entera.
    dialogo.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const hayAbierto = fichas.some(
        (f) => f.querySelector<HTMLElement>("[data-menu]")?.hidden === false
      );
      if (hayAbierto) {
        e.preventDefault();
        cerrarMenus();
      }
    });
  }
</script>
