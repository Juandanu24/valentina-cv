---
import { projects } from "../data/site";

const cardStyles = [
  "bg-magenta text-white",
  "bg-yellow text-ink",
  "bg-violet text-white",
  "bg-teal text-ink",
];
---

<section id="proyectos" class="relative px-5 py-24 sm:px-8 sm:py-32 lg:px-12">
  <div data-reveal class="mb-12 flex flex-wrap items-baseline justify-between gap-3">
    <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink/50">
      05 — proyectos
    </p>
    <p class="max-w-xs font-mono text-[11px] leading-relaxed text-ink/40">
      Áreas donde entrego valor. Sin nombres de marca, por decisión de Valentina.
    </p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 sm:gap-6">
    {
      projects.map((p, i) => (
        <article
          data-reveal
          class:list={[
            "group relative flex min-h-[11rem] flex-col justify-between overflow-hidden rounded-2xl border-2 border-ink p-7 shadow-hard-lg transition-transform duration-300 hover:-translate-y-1 sm:min-h-[14rem] sm:p-8",
            cardStyles[i % cardStyles.length],
          ]}
        >
          <span class="font-mono text-sm font-bold opacity-70">
            0{i + 1}
          </span>
          <h3 class="font-display text-2xl font-extrabold leading-tight sm:text-3xl">
            {p.category}
          </h3>
        </article>
      ))
    }
  </div>
</section>
