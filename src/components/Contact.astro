---
import { site } from "../data/site";

const phoneDigits = site.phone.replace(/\D/g, "");
const whatsapp = `https://wa.me/57${phoneDigits}`;
const firstName = site.name.split(" ")[0];
---

<section
  id="contacto"
  class="relative overflow-hidden bg-ink px-5 py-24 text-paper sm:px-8 sm:py-40 lg:px-12"
>
  <p
    data-reveal
    class="mb-8 font-mono text-xs uppercase tracking-[0.25em] text-paper/50"
  >
    06 — hablemos
  </p>

  <h2
    data-reveal
    class="font-display text-[clamp(2.6rem,10vw,9rem)] font-extrabold leading-[0.9]"
  >
    ¿Trabajamos<br /><span class="text-magenta">juntos?</span>
  </h2>

  <div data-reveal class="mt-14 flex flex-col gap-4 sm:mt-16">
    <a
      href={`mailto:${site.email}`}
      class="group inline-flex w-fit items-center gap-3 font-display text-xl font-bold transition-colors hover:text-yellow sm:text-3xl"
    >
      <span class="break-all">{site.email}</span>
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
    <a
      href={whatsapp}
      target="_blank"
      rel="noopener"
      class="group inline-flex w-fit items-center gap-3 font-mono text-base text-paper/70 transition-colors hover:text-teal sm:text-lg"
    >
      WhatsApp · {site.phone}
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>

  <div
    data-reveal
    class="mt-20 flex flex-wrap items-center justify-between gap-4 border-t-2 border-paper/15 pt-8 font-mono text-[11px] uppercase tracking-widest text-paper/50"
  >
    <span>{firstName} · {site.location}</span>
    <span>{site.availability}</span>
    <span>© 2026 — hecho con cariño</span>
  </div>
</section>
