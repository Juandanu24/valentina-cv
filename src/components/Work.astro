---
import { projects, site } from "../data/site";

// Placeholders (picsum) hasta que llegue el material real de Valentina.
const placeholder = (seed: string, i: number) =>
  `https://picsum.photos/seed/${encodeURIComponent(seed)}-${i}/600/750`;

// Proyectos cuyo material real incluye video.
const hasVideo = new Set(["Dondi", "S Ingeniería", "Kepagro"]);
---

<section id="trabajo" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 data-reveal class="font-display text-4xl leading-tight text-marino sm:text-5xl">
      Proyectos destacados
    </h2>
    <p data-reveal class="font-mono text-[11px] uppercase tracking-widest text-marino/45">
      {projects.length} proyectos
    </p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((p, idx) => (
        <article
          data-reveal
          class:list={[
            "group flex flex-col overflow-hidden rounded-suave border bg-hueso shadow-[0_2px_10px_rgba(30,42,56,0.07)] transition-all duration-300 hover:-translate-y-1.5 hover:border-vino hover:shadow-[0_14px_32px_rgba(110,31,42,0.18)]",
            p.emphasis === "destacada" ? "border-vino/60" : "border-marino/15",
          ]}
        >
          {/* Carrusel automático de piezas */}
          <div
            class="carrusel relative aspect-[4/5] overflow-hidden bg-marino/10"
            data-carrusel
          >
            {Array.from({ length: p.pieces }, (_, i) => (
              <img
                src={placeholder(p.client + p.role, i)}
                alt={`Pieza ${i + 1} — ${p.client} (material real en camino)`}
                loading="lazy"
                width="600"
                height="750"
                class:list={[
                  "absolute inset-0 h-full w-full object-cover transition-opacity duration-700",
                  i === 0 ? "opacity-100" : "opacity-0",
                ]}
                data-slide
              />
            ))}

            {hasVideo.has(p.client) && (
              <span class="pointer-events-none absolute left-3 top-3 flex items-center gap-1.5 bg-marino/75 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-hueso">
                <svg width="8" height="9" viewBox="0 0 14 16" fill="currentColor" aria-hidden="true">
                  <path d="M0 0 L14 8 L0 16 Z" />
                </svg>
                video
              </span>
            )}

            {/* Indicadores de posición */}
            <div class="pointer-events-none absolute bottom-3 left-3 flex gap-1">
              {Array.from({ length: p.pieces }, (_, i) => (
                <span
                  class:list={[
                    "h-1 w-4 transition-colors duration-500",
                    i === 0 ? "bg-hueso" : "bg-hueso/35",
                  ]}
                  data-dot
                />
              ))}
            </div>
          </div>

          {/* Cuerpo */}
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-2xl leading-tight text-marino transition-colors duration-300 group-hover:text-vino">
                {p.client}
              </h3>
              <span class="shrink-0 font-mono text-[10px] uppercase tracking-widest text-marino/40">
                {String(idx + 1).padStart(2, "0")}
              </span>
            </div>
            <p class="mt-0.5 font-body text-sm text-marino/55">{p.sector}</p>

            <p class="mt-3 font-mono text-[10px] font-bold uppercase leading-relaxed tracking-[0.14em] text-vino">
              {p.role}
            </p>

            <p class="mt-3 text-sm leading-relaxed text-tinta/80">{p.description}</p>

            <ul class="mt-4 flex flex-wrap gap-1.5">
              {p.tags.map((t) => (
                <li class="rounded-pill border border-marino/20 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-marino/70">
                  {t}
                </li>
              ))}
            </ul>

            {/* Línea de resultado: mismo tratamiento en las seis, y siempre al pie
                de la tarjeta para que todas queden alineadas. */}
            <div class="mt-auto pt-5">
              <p
                class="flex min-h-[3.75rem] items-center rounded-suave bg-vino px-4 py-3 font-mono text-[11px] uppercase leading-snug tracking-wide text-hueso"
              >
                ▸ {p.result}
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Remate de sección: CTA de temperatura alta -->
  <p data-reveal class="mt-14 text-center">
    <a
      href={site.whatsapp}
      target="_blank"
      rel="noopener"
      class="group font-display text-2xl text-vino transition-colors hover:text-quemado sm:text-2xl"
    >
      ¿Quieres resultados así para tu marca? Escríbeme
      <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
    </a>
  </p>
</section>

<script>
  const INTERVALO = 2500;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-carrusel]").forEach((box) => {
    const slides = box.querySelectorAll<HTMLElement>("[data-slide]");
    const dots = box.querySelectorAll<HTMLElement>("[data-dot]");
    if (slides.length < 2 || reduce) return;

    let actual = 0;
    let timer: number | undefined;

    const mostrar = (i: number) => {
      slides[actual]?.classList.replace("opacity-100", "opacity-0");
      dots[actual]?.classList.replace("bg-hueso", "bg-hueso/35");
      actual = i;
      slides[actual]?.classList.replace("opacity-0", "opacity-100");
      dots[actual]?.classList.replace("bg-hueso/35", "bg-hueso");
    };

    const arrancar = () => {
      timer ??= window.setInterval(
        () => mostrar((actual + 1) % slides.length),
        INTERVALO
      );
    };
    const parar = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    // Solo rota mientras la tarjeta está en pantalla.
    new IntersectionObserver(
      ([e]) => (e.isIntersecting ? arrancar() : parar()),
      { threshold: 0.2 }
    ).observe(box);

    // Pausa al pasar el mouse para poder apreciar la pieza.
    box.addEventListener("mouseenter", parar);
    box.addEventListener("mouseleave", () => {
      if (box.getBoundingClientRect().top < window.innerHeight) arrancar();
    });
  });
</script>
