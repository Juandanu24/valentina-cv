---
import { site, contacto } from "../data/site";
---

<section id="contacto" class="bg-marino px-5 py-24 text-hueso sm:px-8 sm:py-36">
  <div class="mx-auto max-w-4xl">
    <h2
      data-reveal
      class="font-display text-[clamp(2.2rem,6vw,4.2rem)] leading-tight"
    >
      {contacto.title}
    </h2>
    <p data-reveal class="mt-5 max-w-xl text-lg text-hueso/80 sm:text-xl">
      {contacto.subtitle}
    </p>

    <!-- Jerarquía: un solo protagonista -->
    <div data-reveal class="mt-12 flex flex-col items-start gap-5">
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener"
        class="rounded-pill bg-vino px-8 py-4 font-mono text-sm font-bold uppercase tracking-widest text-hueso transition-colors hover:bg-quemado sm:px-10 sm:py-5 sm:text-base"
      >
        {contacto.ctaPrimary}
      </a>

      <button
        id="btn-pdf"
        type="button"
        class="rounded-pill border border-hueso/40 px-5 py-2.5 font-mono text-xs uppercase tracking-widest text-hueso/85 transition-colors hover:border-hueso hover:text-hueso"
      >
        {contacto.ctaSecondary}
      </button>
      <p id="pdf-aviso" class="hidden font-mono text-xs text-hueso/60" role="status">
        Pronto estará disponible esta función.
      </p>

      <p class="mt-2 font-mono text-xs tracking-wide text-hueso/60">
        <a href={`mailto:${site.email}`} class="underline-offset-4 transition-colors hover:text-hueso hover:underline">
          {site.email}
        </a>
        {site.linkedin && (
          <>
            {" · "}
            <a href={site.linkedin} target="_blank" rel="noopener" class="underline-offset-4 transition-colors hover:text-hueso hover:underline">
              LinkedIn
            </a>
          </>
        )}
      </p>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("btn-pdf");
  const aviso = document.getElementById("pdf-aviso");
  btn?.addEventListener("click", () => {
    aviso?.classList.remove("hidden");
  });
</script>
