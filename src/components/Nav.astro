---
import { site } from "../data/site";
---

<nav
  class="fixed inset-x-0 top-0 z-50 border-b border-marino/10 bg-hueso/95 backdrop-blur-sm"
  aria-label="Principal"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href="#" class="font-display text-sm font-bold tracking-tight text-marino">
      {site.name}
    </a>

    <div class="hidden items-center gap-6 font-mono text-[11px] uppercase tracking-widest text-marino/70 md:flex">
      <a href="#trabajo" class="transition-colors hover:text-vino">Mi trabajo</a>
      <a href="#filosofia" class="transition-colors hover:text-vino">Mi filosofía</a>
      <a href="#contacto" class="transition-colors hover:text-vino">Contacto</a>
    </div>

    <a
      href={site.whatsapp}
      target="_blank"
      rel="noopener"
      class="bg-vino px-4 py-2 font-mono text-[11px] uppercase tracking-widest text-hueso transition-colors hover:bg-quemado"
    >
      Escríbeme
    </a>
  </div>
</nav>
