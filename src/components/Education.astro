---
import { education } from "../data/site";

const accents = ["bg-teal", "bg-yellow"];
const rots = [-1.5, 1.5];
---

<section id="educacion" class="relative px-5 py-24 sm:px-8 sm:py-32 lg:px-12">
  <p
    data-reveal
    class="mb-12 font-mono text-xs uppercase tracking-[0.25em] text-ink/50"
  >
    03 — educación
  </p>

  <div class="grid gap-6 sm:grid-cols-2 sm:gap-8">
    {
      education.map((e, i) => (
        <article
          data-reveal
          class="relative overflow-hidden rounded-2xl border-2 border-ink bg-paper p-7 shadow-hard-lg sm:p-8"
          style={`rotate: ${rots[i % rots.length]}deg`}
        >
          <span
            class:list={[
              "absolute right-0 top-0 h-16 w-16 rounded-bl-2xl border-b-2 border-l-2 border-ink",
              accents[i % accents.length],
            ]}
            aria-hidden="true"
          />
          <h3 class="max-w-[85%] font-display text-2xl font-extrabold leading-tight sm:text-3xl">
            {e.title}
          </h3>
          <p class="mt-2 font-mono text-sm uppercase tracking-wider text-violet">
            {e.org}
          </p>
          <p class="mt-5 text-ink/70">{e.detail}</p>
        </article>
      ))
    }
  </div>
</section>
